# Copy to .env (never commit .env) — loaded by `npm run server`.

# Port for the API server (default 3001)
PORT=3001

# Long random string used to read/delete messages via /api/messages.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Comma-separated origins allowed to call the API from a browser.
# In dev the Vite proxy makes this unnecessary; set it to your deployed site in production
# if the frontend is hosted separately from the API.
CORS_ORIGINS=http://localhost:5173

# Where messages are stored (default: server/data/messages.json)
# DATA_FILE=server/data/messages.json
